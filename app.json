{
  "expo": {
    "name": "Festival Compass",
    "slug": "festival-compass",
    "scheme": "festivalcompass",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07070b",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tw1tchy.festivalcompass"
    },
    "android": {
      "package": "com.tw1tchy.festivalcompass",
      "adaptiveIcon": {
        "backgroundColor": "#07070b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Festival Compass uses your location to point you toward your friends."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Festival Compass uses the camera to scan a friend's festival QR code."
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "Festival Compass connects to your Meshtastic radio over Bluetooth."
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ]
    ]
  }
}
